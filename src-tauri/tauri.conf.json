{
  "$schema": "https://raw.githubusercontent.com/nicedoc/windows-blur/tauri-v2/tauri.conf.json",
  "productName": "XCopy",
  "version": "0.2.0",
  "identifier": "com.xcopy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XCopy",
        "width": 420,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "shadow": false
      },
      {
        "label": "quick-paste",
        "url": "quick_paste.html",
        "title": "Quick Paste",
        "width": 320,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "欢迎使用 XCopy",
        "width": 480,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer_hooks.nsh"
      }
    }
  }
}
